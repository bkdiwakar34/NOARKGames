# Kernel module build artifacts
ov9281/module/*.o
ov9281/module/*.ko
ov9281/module/*.mod
ov9281/module/*.mod.c
ov9281/module/*.mod.o
ov9281/module/.*.cmd
ov9281/module/*.symvers
ov9281/module/*.order
ov9281/module/.tmp_versions/
ov9281/module/modules.order

# Compiled device-tree blobs (regenerated from .dtso sources) — except the
# overlay/ ones: nothing here actually compiles those from the .dtso source,
# deploy_efi_dtb.sh reads the prebuilt binaries directly, so they need tracking.
*.dtbo
*.dtb
!ov9281/overlay/*.dtbo
!ov9281/overlay/*.dtb

# Captured frames are large; keep sources, not data
ov9281/captures/*.raw
ov9281/captures/*.pgm
ov9281/captures/*.png

# Demo capture output (root)
/cam*.png

# Python
__pycache__/
*.pyc
.venv/

# Downloaded reference pages: keep the .html, drop the heavy asset dirs
docs/*_files/

# Claude Code local tooling
.claude/
/target/