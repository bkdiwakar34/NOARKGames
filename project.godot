; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="NOARKGames"
run/main_scene="res://app/ui/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://dliw4qk8oe66i"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=2000

[autoload]

PatientDB="*res://app/platform/patient_db.gd"
GlobalSignals="*res://app/platform/global_signals.gd"
UDPReceiver="*res://app/platform/udp_receiver.gd"
SessionManager="*res://app/platform/session_manager.gd"
AdaptiveManager="*res://app/platform/adaptive_manager.gd"
WorkspaceConfig="*res://app/platform/workspace_config.gd"
AudioManager="*res://app/platform/audio_manager.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[dotnet]

project/assembly_name="Oskar Game v2"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/easy_charts/plugin.cfg")

[filesystem]

import/blender/enabled=false

